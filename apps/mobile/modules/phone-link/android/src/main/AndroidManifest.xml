<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Receives notifications only after the person turns on Notification access for Cowork. -->
    <service
      android:name="expo.modules.phonelink.NotifyService"
      android:exported="true"
      android:label="Cowork Phone link"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
  </application>
</manifest>
