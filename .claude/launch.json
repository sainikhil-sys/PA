{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev (attach to running)",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "dev (test db)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-test.mjs"
      ],
      "port": 3200
    },
    {
      "name": "prod (test db)",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/dev-test.mjs",
        "--prod"
      ],
      "port": 3200
    }
  ]
}
