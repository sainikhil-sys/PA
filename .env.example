# ─────────────────────────────────────────────────────────────
# PA environment. Copy to .env.local for development.
# Never commit real values. Empty values are treated as unset.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployment (no trailing slash). Used for OAuth redirects and the MCP URL.
APP_URL=https://your-domain.com

# ── Sign-in (email one-time codes) ───────────────────────────
# Only these emails can sign in (single-user guard). Comma separated.
# Sign-up: "open" lets anyone with an email create an account; "allowlist" (default) admits only ALLOWED_EMAILS.
SIGNUP_MODE=open
ALLOWED_EMAILS=you@example.com
# Admins get Telegram alerts (defaults to ALLOWED_EMAILS).
ADMIN_EMAILS=
# 32+ random chars, used to HMAC sign-in codes. `openssl rand -base64 48`
AUTH_SECRET=
# Resend API key for sending the 6-digit code (https://resend.com). Without it,
# development prints the code to the server console; production refuses to start a login.
RESEND_API_KEY=
# Verified sender, e.g. "PA <login@your-domain.com>"
# Use an address on a domain verified in Resend, e.g. "Cowork <hello@mail.yourdomain.com>".
# Until a domain is verified, Resend only delivers to your own Resend account address.
MAIL_FROM=
# Test mode: fixed code 424242 and no email. Refused on Vercel production. Leave unset.
OTP_TEST_MODE=

# ── Database (Supabase Postgres + pgvector) ──────────────────
# Supabase → Database → Extensions: enable "vector".
# Supabase → Connect → Transaction pooler (port 6543). Used by the app (serverless).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase → Connect → Session pooler (port 5432) or Direct connection. Used for migrations.
DATABASE_URL_UNPOOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional: a SEPARATE Supabase project for Playwright e2e (it is reset on every run).
E2E_DATABASE_URL=
E2E_DATABASE_URL_UNPOOLED=

# 32 bytes, base64. Encrypts OAuth/API tokens at rest (AES-256-GCM). `openssl rand -base64 32`
ENCRYPTION_KEY=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`. 16+ chars.
CRON_SECRET=

# ── Rate limiting (Upstash Redis) ────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Google (Gmail read + drafts, Calendar read, Drive read) ──
# OAuth client (Web). Redirect URI: https://your-domain.com/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI (any OpenAI-compatible endpoint serving open-weight models) ──
# Examples: https://api.together.xyz/v1 · https://api.groq.com/openai/v1 · https://api.fireworks.ai/inference/v1 · https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
# Classification / bulk work
FAST_MODEL=meta-llama/Llama-3.1-8B-Instruct-Turbo
# Briefings, drafting, chat
SMART_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Must output 1024 dimensions (e.g. BAAI/bge-large-en-v1.5). Optional: keyword search works without it.
EMBEDDING_MODEL=
# Optional fallback provider, tried if the primary fails or times out
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_FAST_MODEL=
AI_FALLBACK_SMART_MODEL=
# Local development only (never used on Vercel)
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
AI_TIMEOUT_MS=45000

# ── Voice (optional; browsers' built-in speech is the default) ──
# Speech-to-text: OpenAI-compatible /audio/transcriptions serving Whisper
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3
# Text-to-speech: OpenAI-compatible /audio/speech (e.g. Kokoro-FastAPI, Piper behind a shim)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=kokoro
TTS_VOICE=af_heart

# ── News ribbon ──────────────────────────────────────────────
# Override default RSS/Atom feeds: "Name|https://feed-url|category;Name|https://…|category"
NEWS_FEEDS=
# Optional NewsAPI.org key for extra headlines (titles + descriptions only)
NEWS_API_KEY=

# ── Web search (optional) ────────────────────────────────────
# Tavily search API key (https://tavily.com). Server-side only. Lets the agent look things up
# online and cite the pages. Without it, chat says web search isn't set up (no fake results).
TAVILY_API_KEY=

# ── Notifications (optional) ─────────────────────────────────
# Telegram bot that messages ONLY your own chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Claude connector ─────────────────────────────────────────
# Hosts allowed to receive OAuth codes (default below). Keep it tight.
MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1

# ── OAuth apps for integrations (optional) ──────────────────
# LinkedIn app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect".
# Redirect URL: https://your-domain.com/api/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional override, e.g. 202607 (default: about three months back)
LINKEDIN_API_VERSION=
# Canva Connect integration (scopes design:meta:read profile:read).
# Redirect URL: https://your-domain.com/api/integrations/canva/callback
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Firebase Cloud Messaging (optional extra phone push channel; standard Web Push works without it)
# Firebase console > Project settings > General > Your apps > Web app config, as one-line JSON:
NEXT_PUBLIC_FIREBASE_CONFIG=
# Project settings > Cloud Messaging > Web Push certificates > Key pair (public key):
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Project settings > Service accounts > Generate new private key (paste the JSON on one line). SECRET.
FIREBASE_SERVICE_ACCOUNT=

# Browser Web Push (VAPID). Generate once with `npx web-push generate-vapid-keys`.
# The private key is SECRET. Subject is a mailto: or https: contact for push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Test runs only: "true" routes AI calls to the built-in mock (app/api/dev/mock-ai). Never in production.
AI_MOCK=

# Maintenance mode: "on" shows the maintenance page on the website (legal pages stay readable) and
# makes signed-in API routes answer 503 with code "maintenance". Change it, then redeploy.
MAINTENANCE_MODE=
